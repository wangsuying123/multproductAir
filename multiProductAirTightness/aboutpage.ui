  <property name="styleSheet">
   <string notr="true">
/* 全局样式 - 赛博朋克暗青蓝主题 */
QWidget#AboutPage {
    background-color: #0a1929;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-size: 18px;
    color: #e2e8f0;
}

/* 主内容卡片 */
QWidget#contentCard {
    background: rgba(17, 45, 78, 0.9);
    border: 1px solid rgba(100, 210, 255, 0.4);
    border-radius: 20px;
}

/* Logo区域 */
QLabel#logoLabel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1e5f74, stop:1 #3282b8);
    border-radius: 30px;
    border: 3px solid #64d2ff;
    color: #64d2ff;
    font-size: 38px;
    font-weight: bold;
}

/* 标题样式 */
QLabel#titleLabel {
    color: #64d2ff;
    font-size: 34px;
    font-weight: bold;
    background: transparent;
}

/* 副标题/产品名 */
QLabel#productLabel {
    color: #97e7ff;
    font-size: 20px;
    font-weight: 500;
    background: transparent;
}

/* 版本标签 - 胶囊样式 */
QLabel#versionLabel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1e5f74, stop:1 #3282b8);
    color: #64d2ff;
    border: 2px solid #64d2ff;
    border-radius: 14px;
    padding: 6px 20px;
    font-size: 18px;
    font-weight: 600;
}

/* 描述文字 */
QLabel#descriptionLabel {
    color: #b8c5d6;
    font-size: 18px;
    line-height: 1.8;
    padding: 10px 20px;
    background: transparent;
}

/* 分割线 */
QFrame#dividerLine {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 transparent, stop:0.2 #3282b8, stop:0.8 #3282b8, stop:1 transparent);
    max-height: 2px;
    min-height: 2px;
}

/* 特性标签 */
QLabel#feature1, QLabel#feature2, QLabel#feature3, QLabel#feature4 {
    background: rgba(100, 210, 255, 0.1);
    color: #64d2ff;
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 17px;
    font-weight: 500;
}

/* 信息卡片 */
QWidget#companyCard, QWidget#contactCard {
    background: rgba(10, 25, 41, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-radius: 16px;
}

/* 信息卡片图标 */
QLabel#companyIcon, QLabel#contactIcon {
    font-size: 24px;
    background: transparent;
}

/* 信息卡片标题 */
QLabel#companyTitle, QLabel#contactTitle {
    color: #94a3b8;
    font-size: 17px;
    background: transparent;
}

/* 信息卡片内容 */
QLabel#companyLabel {
    color: #e2e8f0;
    font-size: 19px;
    font-weight: 600;
    background: transparent;
}

QLabel#contactLabel {
    color: #64d2ff;
    font-size: 19px;
    font-weight: 600;
    background: transparent;
}

/* 底部装饰条 */
QLabel#bottomDecor {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1e5f74, stop:0.5 #64d2ff, stop:1 #1e5f74);
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
}

/* 版权信息 */
QLabel#copyrightLabel {
    color: #64748b;
    font-size: 17px;
    background: transparent;
}
