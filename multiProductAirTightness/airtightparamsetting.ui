  <property name="styleSheet">
   <string notr="true">
/* 全局样式 - 赛博朋克暗青蓝主题 */
QWidget#AirtightParamSetting {
    background-color: #0a1929;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-size: 15px;
    color: #e2e8f0;
}

/* 滚动区域 */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 标题框架 */
QFrame#titleFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #112d4e, stop:0.5 #1e5f74, stop:1 #3282b8);
    border-radius: 12px;
    border: 1px solid #3282b8;
    min-height: 60px;
}

/* 标题标签 */
QLabel#titleLabel {
    font-size: 20px;
    font-weight: 700;
    color: #64d2ff;
    background: transparent;
}

/* 状态标签 */
QLabel#connectionStatusLabel, QLabel#pressureStatusLabel, QLabel#mainboardStatusLabel {
    font-size: 15px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    background: rgba(255, 82, 82, 0.15);
    border: 1px solid rgba(255, 82, 82, 0.5);
    color: #ff5252;
}

/* 分组框样式 */
QGroupBox {
    background: rgba(17, 45, 78, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.4);
    border-radius: 12px;
    margin-top: 20px;
    padding: 20px;
    padding-top: 35px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 20px;
    top: 5px;
    color: #64d2ff;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
    padding: 0 10px;
}

/* 普通标签 */
QLabel {
    color: #e2e8f0;
    font-weight: 500;
    background: transparent;
    font-size: 15px;
}

/* 输入框样式 */
QLineEdit {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 8px;
    padding: 10px 15px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 20px;
}

QLineEdit:focus {
    border-color: #64d2ff;
    background: rgba(17, 45, 78, 0.9);
}

QLineEdit:hover {
    border-color: #42a5f5;
}

/* 下拉框样式 */
QComboBox {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 8px;
    padding: 10px 15px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 20px;
    min-width: 100px;
}

QComboBox:focus {
    border-color: #64d2ff;
}

QComboBox:hover {
    border-color: #42a5f5;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background: #112d4e;
    border: 1px solid #3282b8;
    border-radius: 6px;
    color: #f8fafc;
    selection-background-color: #1e5f74;
    selection-color: #64d2ff;
    padding: 5px;
}

/* 数值输入框样式 */
QDoubleSpinBox, QSpinBox {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 8px;
    padding: 10px 15px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 20px;
    min-width: 100px;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #64d2ff;
    background: rgba(17, 45, 78, 0.9);
}

QDoubleSpinBox:hover, QSpinBox:hover {
    border-color: #42a5f5;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    background: rgba(50, 130, 184, 0.5);
    border: none;
    border-radius: 4px;
    width: 20px;
    margin: 2px;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: rgba(100, 210, 255, 0.5);
}

/* 保存按钮 - 蓝色 */
QPushButton#saveParametersButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #42a5f5, stop:1 #1e88e5);
    color: white;
    border: 2px solid #42a5f5;
    border-radius: 10px;
    padding: 12px 25px;
    font-size: 14px;
    font-weight: bold;
    min-width: 120px;
}

QPushButton#saveParametersButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #64b5f6, stop:1 #42a5f5);
    border-color: #64b5f6;
}

QPushButton#saveParametersButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1e88e5, stop:1 #1565c0);
}

/* 发送按钮 - 绿色 */
QPushButton#sendToDeviceButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00e676, stop:1 #00c853);
    color: white;
    border: 2px solid #00e676;
    border-radius: 10px;
    padding: 12px 25px;
    font-size: 14px;
    font-weight: bold;
    min-width: 120px;
}

QPushButton#sendToDeviceButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #69f0ae, stop:1 #00e676);
    border-color: #69f0ae;
}

QPushButton#sendToDeviceButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00c853, stop:1 #00a844);
}

/* 滚动条样式 */
QScrollBar:vertical {
    background: rgba(17, 45, 78, 0.5);
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #64d2ff;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #97e7ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: rgba(17, 45, 78, 0.5);
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #64d2ff;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #97e7ff;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
