  <property name="windowTitle">
   <string>通信连接</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* 全局样式 - 赛博朋克暗青蓝主题 */
QWidget#CommsPage {
    background-color: #0a1929;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-size: 16px;
    color: #e2e8f0;
}

/* 滚动区域 */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* 状态栏框架 */
QFrame#statusFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #112d4e, stop:0.5 #1e5f74, stop:1 #3282b8);
    border-radius: 8px;
    border: 1px solid #3282b8;
    min-height: 45px;
}

/* 状态标签 */
QLabel#airtightStatusLabel, QLabel#mainboardStatusLabel, QLabel#pressureStatusLabel {
    font-size: 16px;
    font-weight: 700;
    color: #f8fafc;
    background: transparent;
}

QLabel#airtightStatus, QLabel#mainboardStatus, QLabel#pressureStatus {
    font-size: 16px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 6px;
    min-width: 60px;
    text-align: center;
}

/* Tab控件样式 */
QTabWidget::pane {
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-radius: 8px;
    background: rgba(17, 45, 78, 0.6);
    top: -1px;
}

QTabBar::tab {
    background: rgba(17, 45, 78, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 25px;
    margin-right: 3px;
    font-weight: 600;
    font-size: 16px;
    color: #94a3b8;
    min-width: 80px;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e5f74, stop:1 #112d4e);
    color: #64d2ff;
    border-bottom: 2px solid #64d2ff;
}

QTabBar::tab:hover:!selected {
    background: rgba(30, 95, 116, 0.6);
    color: #64d2ff;
}

/* 内容框架 */
QFrame#airtightFrame, QFrame#mainBoardFrame, QFrame#pressureFrame {
    background: rgba(17, 45, 78, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.4);
    border-radius: 10px;
}

/* 标题标签 */
QLabel#titleLabel, QLabel#titleLabel_2, QLabel#titleLabel_3 {
    font-size: 18px;
    font-weight: 700;
    color: #64d2ff;
    padding: 6px 0;
    background: transparent;
}

/* 普通标签 */
QLabel {
    color: #e2e8f0;
    font-weight: 500;
    background: transparent;
}

/* 输入框样式 */
QLineEdit {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 6px;
    padding: 8px 10px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 24px;
}

QLineEdit:focus {
    border-color: #64d2ff;
    background: rgba(17, 45, 78, 0.9);
}

QLineEdit:hover {
    border-color: #42a5f5;
}

/* 下拉框样式 */
QComboBox {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 6px;
    padding: 8px 10px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 24px;
}

QComboBox:focus {
    border-color: #64d2ff;
}

QComboBox:hover {
    border-color: #42a5f5;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox QAbstractItemView {
    background: #112d4e;
    border: 1px solid #3282b8;
    border-radius: 5px;
    color: #f8fafc;
    selection-background-color: #1e5f74;
    selection-color: #64d2ff;
    padding: 4px;
}

/* 连接按钮 - 绿色 */
QPushButton#connectionButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00e676, stop:1 #00c853);
    color: white;
    border: 2px solid #00e676;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 16px;
    font-weight: bold;
    min-width: 100px;
}

QPushButton#connectionButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #69f0ae, stop:1 #00e676);
    border-color: #69f0ae;
}

QPushButton#connectionButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00c853, stop:1 #00a844);
}

QPushButton#connectionButton:disabled {
    background: rgba(100, 100, 100, 0.5);
    border-color: #666;
    color: #888;
}

/* 断开按钮 - 红色 */
QPushButton#disconnectButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff5252, stop:1 #d32f2f);
    color: white;
    border: 2px solid #ff5252;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 16px;
    font-weight: bold;
    min-width: 100px;
}

QPushButton#disconnectButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff8a80, stop:1 #ff5252);
    border-color: #ff8a80;
}

QPushButton#disconnectButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #d32f2f, stop:1 #b71c1c);
}

QPushButton#disconnectButton:disabled {
    background: rgba(100, 100, 100, 0.5);
    border-color: #666;
    color: #888;
}

/* 刷新按钮 - 蓝色 */
QPushButton#refreshSerialPortButton, QPushButton#refreshSerialPortButton_2, QPushButton#refreshSerialPortButton_3 {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #42a5f5, stop:1 #1e88e5);
    color: white;
    border: 2px solid #42a5f5;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#refreshSerialPortButton:hover, QPushButton#refreshSerialPortButton_2:hover, QPushButton#refreshSerialPortButton_3:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #64b5f6, stop:1 #42a5f5);
    border-color: #64b5f6;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background: rgba(17, 45, 78, 0.5);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #64d2ff;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #97e7ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
