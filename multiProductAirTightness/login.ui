  <property name="styleSheet">
   <string notr="true">
/* 主窗口背景 - 赛博朋克暗青蓝主题 */
QWidget#Login {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
        stop:0 #0a1929, stop:0.5 #112d4e, stop:1 #1e5f74);
    font-family: 'Microsoft YaHei UI', 'SimHei', sans-serif;
}

/* 登录卡片容器 */
QFrame#loginCard {
    background: rgba(17, 45, 78, 0.95);
    border-radius: 20px;
    border: 2px solid rgba(100, 210, 255, 0.4);
}

/* Logo图标样式 */
QLabel#logoLabel {
    font-size: 56px;
    color: #64d2ff;
    font-weight: bold;
    background: transparent;
}

/* 标题样式 */
QLabel#titleLabel {
    font-size: 26px;
    font-weight: 700;
    color: #64d2ff;
    letter-spacing: 3px;
    background: transparent;
}

/* 副标题样式 */
QLabel#subtitleLabel {
    font-size: 14px;
    color: #94a3b8;
    letter-spacing: 2px;
    background: transparent;
}

/* 输入框标签样式 */
QLabel#usernameLabel, QLabel#passwordLabel {
    font-size: 14px;
    font-weight: 600;
    color: #e2e8f0;
    background: transparent;
}

/* 输入框样式 */
QLineEdit {
    height: 48px;
    border: 2px solid #3282b8;
    border-radius: 12px;
    padding: 0 18px;
    font-size: 15px;
    background-color: rgba(10, 25, 41, 0.9);
    color: #f8fafc;
}

QLineEdit:hover {
    border-color: #42a5f5;
    background-color: rgba(17, 45, 78, 0.9);
}

QLineEdit:focus {
    border-color: #64d2ff;
    background-color: rgba(17, 45, 78, 0.9);
}

QLineEdit::placeholder {
    color: #64748b;
}

/* 密码显示按钮样式 */
QPushButton#togglePasswordButton {
    background-color: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-left: none;
    border-radius: 0px 12px 12px 0px;
    color: #94a3b8;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
    min-width: 70px;
    max-width: 70px;
    height: 48px;
}

QPushButton#togglePasswordButton:hover {
    color: #64d2ff;
    background-color: rgba(17, 45, 78, 0.9);
    border-color: #42a5f5;
}

/* 记住密码复选框样式 */
QCheckBox#rememberPasswordCheckBox {
    font-size: 14px;
    color: #94a3b8;
    spacing: 10px;
    background: transparent;
}

QCheckBox#rememberPasswordCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #3282b8;
    border-radius: 6px;
    background-color: rgba(10, 25, 41, 0.9);
}

QCheckBox#rememberPasswordCheckBox::indicator:hover {
    border-color: #64d2ff;
}

QCheckBox#rememberPasswordCheckBox::indicator:checked {
    background-color: #64d2ff;
    border-color: #64d2ff;
}

/* 登录按钮样式 */
QPushButton#loginButton {
    height: 52px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00e676, stop:1 #00c853);
    border: 2px solid #00e676;
    border-radius: 12px;
    color: white;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 4px;
}

QPushButton#loginButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #69f0ae, stop:1 #00e676);
    border-color: #69f0ae;
}

QPushButton#loginButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00c853, stop:1 #00a844);
}

QPushButton#loginButton:disabled {
    background: rgba(100, 100, 100, 0.5);
    border-color: #555;
    color: #888;
}

/* 取消按钮样式 */
QPushButton#cancelButton {
    height: 52px;
    background-color: transparent;
    border: 2px solid #3282b8;
    border-radius: 12px;
    color: #94a3b8;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 4px;
}

QPushButton#cancelButton:hover {
    border-color: #64d2ff;
    color: #64d2ff;
    background-color: rgba(100, 210, 255, 0.1);
}

QPushButton#cancelButton:pressed {
    background-color: rgba(100, 210, 255, 0.2);
}

/* 版本号样式 */
QLabel#versionLabel {
    font-size: 12px;
    color: rgba(100, 210, 255, 0.6);
    letter-spacing: 1px;
    background: transparent;
}

/* 装饰线样式 */
QFrame#decorLine {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 transparent, stop:0.5 #64d2ff, stop:1 transparent);
    max-height: 2px;
    min-height: 2px;
}
