  <property name="styleSheet">
   <string notr="true">
/* 全局样式 - 赛博朋克暗青蓝主题 */
* {
    font-family: 'Microsoft YaHei UI', 'SimHei', sans-serif;
    font-size: 14px;
}

/* 主窗口背景 - 深色科技感 */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #0a1929, stop:0.5 #0d2137, stop:1 #0a1929);
}

/* 中央部件背景 */
QWidget#centralWidget {
    background: transparent;
}

/* 菜单栏样式 - 科技感渐变 */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #112d4e, stop:0.3 #1e5f74, stop:0.7 #1e5f74, stop:1 #112d4e);
    color: #f8fafc;
    font-weight: bold;
    font-size: 13px;
    padding: 5px 10px;
    border: none;
    border-bottom: 2px solid #3282b8;
    spacing: 5px;
}

QMenuBar::item {
    background: transparent;
    color: #e2e8f0;
    padding: 6px 12px;
    margin: 2px 3px;
    border-radius: 6px;
    transition: all 0.3s;
}

QMenuBar::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #3282b8, stop:1 #1e5f74);
    color: #ffffff;
    border: 1px solid #64d2ff;
}

QMenuBar::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #42a5f5, stop:1 #1e88e5);
    color: #ffffff;
    border: 1px solid #64d2ff;
}

QMenuBar::item:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #1565c0, stop:1 #0d47a1);
}

/* 下拉菜单样式 */
QMenu {
    background-color: #112d4e;
    color: #e2e8f0;
    border: 1px solid #3282b8;
    border-radius: 8px;
    padding: 8px 5px;
}

QMenu::item {
    background: transparent;
    color: #e2e8f0;
    padding: 10px 30px;
    margin: 2px 5px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #3282b8, stop:1 #1e5f74);
    color: #ffffff;
}

QMenu::item:pressed {
    background: #1565c0;
}

QMenu::separator {
    height: 1px;
    background: #3282b8;
    margin: 5px 10px;
}

/* 堆叠部件样式 */
QStackedWidget {
    background: rgba(17, 45, 78, 0.6);
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-radius: 12px;
    margin: 8px;
}

/* 状态栏样式 */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #112d4e, stop:0.5 #1e5f74, stop:1 #112d4e);
    color: #64d2ff;
    font-weight: 600;
    padding: 8px 15px;
    border: none;
    border-top: 2px solid #3282b8;
}

QStatusBar::item {
    border: none;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background: rgba(17, 45, 78, 0.5);
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #3282b8, stop:1 #64d2ff);
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #42a5f5, stop:1 #97e7ff);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: rgba(17, 45, 78, 0.5);
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #3282b8, stop:1 #64d2ff);
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #42a5f5, stop:1 #97e7ff);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 工具提示样式 */
QToolTip {
    background-color: #112d4e;
    color: #64d2ff;
    border: 1px solid #3282b8;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 13px;
}
   </string>
