  <property name="windowTitle">
   <string>系统设置</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* 全局样式 - 赛博朋克暗青蓝主题 */
QWidget#SystemSetting {
    background-color: #0a1929;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-size: 11px;
    color: #e2e8f0;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 分组框样式 */
QGroupBox {
    background: rgba(17, 45, 78, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.4);
    border-radius: 12px;
    margin-top: 16px;
    padding: 12px;
    padding-top: 28px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 20px;
    top: 5px;
    color: #64d2ff;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
    padding: 0 10px;
}

/* 标签样式 */
QLabel {
    color: #e2e8f0;
    font-weight: 500;
    background: transparent;
}

/* 输入框样式 */
QLineEdit {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 8px;
    padding: 8px 12px;
    color: #f8fafc;
    font-size: 13px;
    min-height: 16px;
}

QLineEdit:focus {
    border-color: #64d2ff;
    background: rgba(17, 45, 78, 0.9);
}

QLineEdit:hover {
    border-color: #42a5f5;
}

/* 下拉框样式 */
QComboBox {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 8px;
    padding: 8px 12px;
    color: #f8fafc;
    font-size: 13px;
    min-height: 16px;
}

QComboBox:focus {
    border-color: #64d2ff;
}

QComboBox:hover {
    border-color: #42a5f5;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background: #112d4e;
    border: 1px solid #3282b8;
    border-radius: 6px;
    color: #f8fafc;
    selection-background-color: #1e5f74;
    selection-color: #64d2ff;
    padding: 5px;
}

/* 时间编辑框 */
QTimeEdit {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 8px;
    padding: 8px 12px;
    color: #f8fafc;
    font-size: 13px;
    min-height: 16px;
}

QTimeEdit:focus {
    border-color: #64d2ff;
}

QTimeEdit:hover {
    border-color: #42a5f5;
}

/* 复选框样式 */
QCheckBox {
    color: #e2e8f0;
    font-size: 12px;
    spacing: 10px;
    padding: 6px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #3282b8;
    background-color: rgba(10, 25, 41, 0.9);
}

QCheckBox::indicator:checked {
    background-color: #64d2ff;
    border-color: #64d2ff;
}

QCheckBox::indicator:hover {
    border-color: #64d2ff;
}

/* Tab控件样式 */
QTabWidget::pane {
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-radius: 12px;
    background: rgba(17, 45, 78, 0.6);
    top: -1px;
}

QTabBar::tab {
    background: rgba(17, 45, 78, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 10px 30px;
    margin-right: 4px;
    font-weight: 600;
    font-size: 12px;
    color: #94a3b8;
    min-width: 100px;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e5f74, stop:1 #112d4e);
    color: #64d2ff;
    border-bottom: 3px solid #64d2ff;
}

QTabBar::tab:hover:!selected {
    background: rgba(30, 95, 116, 0.6);
    color: #64d2ff;
}

/* 默认按钮样式 - 蓝色 */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #42a5f5, stop:1 #1e88e5);
    color: white;
    border: 2px solid #42a5f5;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
    min-width: 70px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #64b5f6, stop:1 #42a5f5);
    border-color: #64b5f6;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1e88e5, stop:1 #1565c0);
}

/* 绿色按钮 - 立即备份 */
QPushButton#manualBackupButton, QPushButton#manualLogBackupButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00e676, stop:1 #00c853);
    border: 2px solid #00e676;
    min-width: 130px;
}

QPushButton#manualBackupButton:hover, QPushButton#manualLogBackupButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #69f0ae, stop:1 #00e676);
    border-color: #69f0ae;
}

QPushButton#manualBackupButton:pressed, QPushButton#manualLogBackupButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00c853, stop:1 #00a844);
}

/* 橙色按钮 - 选择路径 */
QPushButton#selectDataPathButton, QPushButton#selectBackupPathButton, 
QPushButton#selectLogPathButton, QPushButton#selectLogBackupPathButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffa726, stop:1 #fb8c00);
    border: 2px solid #ffa726;
}

QPushButton#selectDataPathButton:hover, QPushButton#selectBackupPathButton:hover,
QPushButton#selectLogPathButton:hover, QPushButton#selectLogBackupPathButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffb74d, stop:1 #ffa726);
    border-color: #ffb74d;
}

QPushButton#selectDataPathButton:pressed, QPushButton#selectBackupPathButton:pressed,
QPushButton#selectLogPathButton:pressed, QPushButton#selectLogBackupPathButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #fb8c00, stop:1 #ef6c00);
}

/* 状态标签 - 最后备份时间 */
QLabel#lastBackupLabel, QLabel#lastLogBackupLabel {
    color: #64d2ff;
    font-size: 12px;
    font-weight: 600;
    padding: 12px 20px;
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid rgba(100, 210, 255, 0.4);
    border-radius: 10px;
    min-width: 180px;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background: rgba(17, 45, 78, 0.5);
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #64d2ff;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #97e7ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: rgba(17, 45, 78, 0.5);
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #64d2ff;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #97e7ff;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
   </string>
