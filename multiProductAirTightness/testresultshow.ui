  <property name="styleSheet">
   <string notr="true">
/* 全局样式 - 赛博朋克暗青蓝主题 */
QWidget#TestResultshow {
    background-color: #0a1929;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-size: 16px;
    color: #e2e8f0;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 分组框样式 */
QGroupBox {
    background: rgba(17, 45, 78, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.4);
    border-radius: 8px;
    margin-top: 10px;
    padding: 8px;
    padding-top: 18px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 2px;
    color: #64d2ff;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
    padding: 0 6px;
}

/* 标签样式 */
QLabel {
    color: #e2e8f0;
    font-weight: 500;
    background: transparent;
}

/* 输入框样式 */
QLineEdit {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 6px;
    padding: 5px 8px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 14px;
}

QLineEdit:focus {
    border-color: #64d2ff;
    background: rgba(17, 45, 78, 0.9);
}

QLineEdit:hover {
    border-color: #42a5f5;
}

/* 下拉框样式 */
QComboBox {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 6px;
    padding: 5px 8px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 14px;
}

QComboBox:focus {
    border-color: #64d2ff;
}

QComboBox:hover {
    border-color: #42a5f5;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background: #112d4e;
    border: 1px solid #3282b8;
    border-radius: 6px;
    color: #f8fafc;
    selection-background-color: #1e5f74;
    selection-color: #64d2ff;
    padding: 5px;
}

/* 日期时间编辑框 */
QDateTimeEdit {
    background: rgba(10, 25, 41, 0.9);
    border: 2px solid #3282b8;
    border-radius: 6px;
    padding: 5px 8px;
    color: #f8fafc;
    font-size: 15px;
    min-height: 14px;
}

QDateTimeEdit:focus {
    border-color: #64d2ff;
}

QDateTimeEdit:hover {
    border-color: #42a5f5;
}

/* 复选框样式 */
QCheckBox {
    color: #e2e8f0;
    font-size: 15px;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 2px solid #3282b8;
    background-color: rgba(10, 25, 41, 0.9);
}

QCheckBox::indicator:checked {
    background-color: #64d2ff;
    border-color: #64d2ff;
}

QCheckBox::indicator:hover {
    border-color: #64d2ff;
}

/* 查询按钮 - 蓝色 */
QPushButton#queryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #42a5f5, stop:1 #1e88e5);
    color: white;
    border: 2px solid #42a5f5;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 15px;
    font-weight: bold;
    min-width: 60px;
}

QPushButton#queryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #64b5f6, stop:1 #42a5f5);
    border-color: #64b5f6;
}

QPushButton#queryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1e88e5, stop:1 #1565c0);
}

/* 导出按钮 - 橙色 */
QPushButton#exportButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffa726, stop:1 #fb8c00);
    color: white;
    border: 2px solid #ffa726;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 15px;
    font-weight: bold;
    min-width: 60px;
}

QPushButton#exportButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffb74d, stop:1 #ffa726);
    border-color: #ffb74d;
}

QPushButton#exportButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #fb8c00, stop:1 #ef6c00);
}

/* 分页按钮 */
QPushButton#pageUpButton, QPushButton#pageDownButton,
QPushButton#firstPageButton, QPushButton#lastPageButton {
    background: rgba(17, 45, 78, 0.8);
    color: #e2e8f0;
    border: 2px solid #3282b8;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 15px;
    font-weight: 600;
    min-width: 60px;
}

QPushButton#pageUpButton:hover, QPushButton#pageDownButton:hover,
QPushButton#firstPageButton:hover, QPushButton#lastPageButton:hover {
    background: rgba(30, 95, 116, 0.8);
    border-color: #64d2ff;
    color: #64d2ff;
}

/* 表格样式 */
QTableWidget {
    background: rgba(17, 45, 78, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.4);
    border-radius: 12px;
    gridline-color: rgba(100, 210, 255, 0.2);
    selection-background-color: rgba(100, 210, 255, 0.3);
    selection-color: #64d2ff;
    alternate-background-color: rgba(10, 25, 41, 0.5);
}

QTableWidget::item {
    padding: 8px 6px;
    border: none;
    color: #e2e8f0;
    font-size: 18px;
}

QTableWidget::item:selected {
    background-color: rgba(100, 210, 255, 0.3);
    color: #64d2ff;
}

QTableWidget::item:hover {
    background-color: rgba(100, 210, 255, 0.15);
}

/* 表格表头 */
QHeaderView::section {
    background: rgba(30, 95, 116, 0.8);
    padding: 6px 5px;
    border: none;
    border-bottom: 2px solid #64d2ff;
    font-weight: 700;
    font-size: 14px;
    color: #64d2ff;
    text-align: center;
}

QHeaderView::section:hover {
    background: rgba(50, 130, 184, 0.8);
}

/* 统计标签 */
QLabel#totalCountLabel, QLabel#totalPagesLabel, QLabel#currentPageLabel {
    color: #94a3b8;
    font-size: 15px;
    font-weight: 600;
    padding: 5px 10px;
    background: rgba(10, 25, 41, 0.8);
    border: 1px solid rgba(100, 210, 255, 0.3);
    border-radius: 6px;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background: rgba(17, 45, 78, 0.5);
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #64d2ff;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #97e7ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: rgba(17, 45, 78, 0.5);
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #64d2ff;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #97e7ff;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
