  <property name="styleSheet">
   <string notr="true">
/* 对话框全局样式 - 高级设计 */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f0f5fa);
    border-radius: 12px;
}

/* 标签样式 - 增强可读性 */
QLabel {
    color: #2c3e50;
    font-size: 14px;
    font-weight: 600;
}

/* 输入框样式 - 现代卡片风格 */
QLineEdit {
    border: 2px solid #e0e6ed;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 14px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #fafbfc);
    color: #2c3e50;
    selection-background-color: #1890ff;
    selection-color: white;
}

QLineEdit:focus {
    border-color: #1890ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f8ff, stop:1 #e6f7ff);
}

QLineEdit:hover {
    border-color: #40a9ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafbfc, stop:1 #f5f7fa);
}

/* 下拉框样式 - 现代设计 */
QComboBox {
    border: 2px solid #e0e6ed;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 14px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #fafbfc);
    color: #2c3e50;
}

QComboBox:focus {
    border-color: #1890ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f8ff, stop:1 #e6f7ff);
}

QComboBox:hover {
    border-color: #40a9ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafbfc, stop:1 #f5f7fa);
}

QComboBox::drop-down {
    border: none;
    width: 35px;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 7px solid #8c8c8c;
    margin-right: 10px;
}

QComboBox:hover::down-arrow {
    border-top-color: #1890ff;
}

QComboBox QAbstractItemView {
    background: white;
    border: 2px solid #1890ff;
    border-radius: 8px;
    color: #2c3e50;
    selection-background-color: #e6f7ff;
    selection-color: #1890ff;
    padding: 6px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    border-radius: 6px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f8ff, stop:1 #e6f7ff);
}

QComboBox QAbstractItemView::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e6f7ff, stop:1 #bae7ff);
    font-weight: 600;
}

/* 单选按钮样式 - 精致设计 */
QRadioButton {
    color: #2c3e50;
    font-size: 14px;
    spacing: 10px;
    font-weight: 600;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border: 3px solid #d9d9d9;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #fafafa);
}

QRadioButton::indicator:hover {
    border-color: #40a9ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f8ff, stop:1 #e6f7ff);
}

QRadioButton::indicator:checked {
    border-color: #1890ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1890ff, stop:1 #0066cc);
    background-image: radial-gradient(circle, white 0%, white 30%, transparent 30%, transparent 100%);
}

/* 按钮通用样式 */
QPushButton {
    border: 2px solid #d9d9d9;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 700;
    min-width: 100px;
    min-height: 42px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* 保存按钮样式 - 绿色主题 */
QPushButton#saveButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #52c41a, stop:1 #389e0d);
    color: white;
    border: none;
}

QPushButton#saveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #73d13d, stop:1 #52c41a);
}

QPushButton#saveButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #389e0d, stop:1 #237804);
    padding: 13px 24px 11px 24px;
}

/* 取消按钮样式 - 灰色主题 */
QPushButton#cancelButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f5f5f5);
    color: #595959;
    border: 2px solid #d9d9d9;
}

QPushButton#cancelButton:hover {
    color: #1890ff;
    border-color: #1890ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f8ff, stop:1 #e6f7ff);
}

QPushButton#cancelButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e6f7ff, stop:1 #bae7ff);
    padding: 13px 24px 11px 24px;
}
   </string>
