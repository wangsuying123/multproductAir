  <property name="styleSheet">
   <string notr="true">
/* 全局样式 - 高级现代风格 */
QWidget#UserManagement {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e8eef5, stop:1 #dce4ed);
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-size: 14px;
    color: #2c3e50;
}

/* 标题样式 - 添加渐变文字效果 */
QLabel#titleLabel {
    font-size: 36px;
    font-weight: 900;
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                           stop:0 #1890ff, stop:0.5 #0066cc, stop:1 #1890ff);
    background: transparent;
    padding: 10px 0px;
    letter-spacing: 1px;
}

/* 副标题样式 */
QLabel#subtitleLabel {
    font-size: 14px;
    color: #8c8c8c;
    background: transparent;
    padding: 0px;
}

/* 新增按钮样式 - 添加阴影和图标效果 */
QPushButton#addUserPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #52c41a, stop:1 #389e0d);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 700;
    min-width: 140px;
    min-height: 44px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QPushButton#addUserPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #73d13d, stop:1 #52c41a);
}

QPushButton#addUserPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #389e0d, stop:1 #237804);
    padding: 13px 28px 11px 28px;
}

/* 表格容器样式 - 添加卡片阴影效果 */
QTableWidget {
    background-color: white;
    border: none;
    border-radius: 12px;
    gridline-color: #f0f0f0;
    selection-background-color: #e6f7ff;
    selection-color: #2c3e50;
    outline: none;
}

/* 表格项样式 - 优化间距和边框 */
QTableWidget::item {
    padding: 16px 18px;
    border: none;
    color: #2c3e50;
    border-bottom: 1px solid #f5f5f5;
    font-size: 16px;
}

QTableWidget::item:selected {
    background-color: #e6f7ff;
    color: #1890ff;
    font-weight: 500;
}

QTableWidget::item:hover {
    background-color: #fafafa;
}

/* 表头样式 - 增强视觉层次 */
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f5f5f5);
    padding: 16px 18px;
    border: none;
    border-bottom: 3px solid #1890ff;
    border-right: 1px solid #f0f0f0;
    font-weight: 800;
    font-size: 15px;
    color: #1890ff;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
    border-right: none;
}

QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e6f7ff, stop:1 #bae7ff);
    color: #0066cc;
}

/* 滚动条样式 - 精致设计 */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #d9d9d9, stop:1 #bfbfbf);
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #bfbfbf, stop:1 #999999);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d9d9d9, stop:1 #bfbfbf);
    border-radius: 6px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #bfbfbf, stop:1 #999999);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 编辑和删除按钮样式已移至代码中设置 */
